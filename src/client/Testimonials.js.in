'use strict';

(() => {
  const section = document.querySelector('#depoimentos');
  if (!section) return;
  const configured = window.SITE_TESTIMONIALS || {};
  // Internal demonstrations require both the flag and a loopback address.
  // document.baseURI also supports the isolated local Design System samples.
  const internalHost = ['localhost', '127.0.0.1', '[::1]'].includes(new URL(document.baseURI).hostname);
  const demoEnabled = window.SITE_CONFIG?.demoTestimonials === true && internalHost;
  const topics = {{testimonialTopics}};
  const safeMedia = value => {
    if (typeof value !== 'string' || !value.trim()) return '';
    try {
      const url = new URL(value, document.baseURI);
      return ['http:', 'https:'].includes(url.protocol) ? url.href : '';
    } catch { return ''; }
  };
  const hasText = value => typeof value === 'string' && Boolean(value.trim());
  const items = topics.map((topic, index) => {
    const data = configured[topic.id] || {};
    const videoSrc = safeMedia(data.videoSrc);
    const poster = safeMedia(data.poster);
    const captionsUrl = safeMedia(data.captionsSrc);
    const captionsSrc = captionsUrl && new URL(captionsUrl).origin === location.origin ? captionsUrl : '';
    const complete = data.authorized === true && videoSrc && poster && captionsSrc &&
      ['client', 'title', 'summary', 'transcript'].every(key => hasText(data[key]));
    return complete
      ? { id: topic.id, tag: topic.tag, ...data, videoSrc, poster, captionsSrc, ready: true }
      : demoEnabled ? { ...topic, client: topic.name, transcript: topic.story, ready: false, portraitIndex: index } : null;
  }).filter(Boolean);
  section.hidden = items.length === 0;
  if (!items.length) return;
  if (items.some(item => !item.ready)) {
    const context = section.querySelector('.testimonials-heading > p');
    const disclosure = document.createElement('strong');
    disclosure.textContent = 'Relatos ilustrativos do protótipo, com personagens fictícios.';
    context.prepend(disclosure, document.createElement('br'));
    section.querySelector('#testimonials-title').innerHTML = 'Possibilidades na prática.<br><em>Veja os relatos.</em>';
  }
  const track = section.querySelector('.testimonials-track');
  const dots = section.querySelector('.testimonials-dots');
  const previous = section.querySelector('.testimonial-prev');
  const next = section.querySelector('.testimonial-next');
  const status = section.querySelector('.testimonials-status');
  const dialog = document.querySelector('#testimonial-dialog');
  const player = dialog.querySelector('#testimonial-player');
  const videoError = dialog.querySelector('#testimonial-video-error');
  const captionsError = dialog.querySelector('#testimonial-captions-error');
  const transcript = dialog.querySelector('#testimonial-transcript');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  let opener;
  let scrollTimer;
  const element = (tag, className, text) => {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text) node.textContent = text;
    return node;
  };
  const icon = name => {
    const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
    svg.setAttribute('class', 'icon');
    svg.setAttribute('aria-hidden', 'true');
    const use = document.createElementNS('http://www.w3.org/2000/svg', 'use');
    use.setAttribute('href', `#${name}`);
    svg.append(use);
    return svg;
  };

  items.forEach((item, index) => {
    const card = element('article', 'testimonial-card');
    card.setAttribute('role', 'group');
    card.setAttribute('aria-roledescription', 'slide');
    card.setAttribute('aria-label', `${index + 1} de ${items.length}: ${item.tag.toLowerCase()}`);
    const cover = element('div', 'testimonial-cover');
    let image;
    if (item.ready) {
      image = element('img', 'testimonial-poster');
      image.src = item.poster;
      image.alt = '';
      image.loading = 'lazy';
    } else {
      image = element('div', 'testimonial-portrait-sprite');
      image.style.backgroundPosition = `${item.portraitIndex * 25}% center`;
      image.setAttribute('role', 'img');
      image.setAttribute('aria-label', item.client);
    }
    const meta = element('div', 'testimonial-cover-meta');
    meta.append(element('span', 'testimonial-video-label', item.ready ? 'DEPOIMENTO' : 'RELATO'));
    const identity = element('div', 'testimonial-video-identity');
    identity.append(element('strong', '', item.client), element('span', '', item.role || ''));
    const play = element('button', 'testimonial-cover-play');
    play.type = 'button';
    play.setAttribute('aria-label', item.ready ? `Assistir ao depoimento de ${item.client}` : `Ler relato de ${item.client}`);
    play.setAttribute('aria-haspopup', 'dialog');
    if (item.ready) play.append(icon('play'));
    else { play.classList.add('is-reading'); play.textContent = 'Ler relato'; }
    play.addEventListener('click', () => openItem(item, play));
    const label = element('div', 'testimonial-media-label', item.ready ? 'Assistir ao depoimento' : 'Ler relato');
    cover.append(image, meta, play, identity, label);
    const body = element('div', 'testimonial-card-body');
    body.append(element('p', 'eyebrow', item.tag), element('h3', '', `“${item.title}”`), cover, element('p', 'testimonial-summary', item.summary));
    const details = element('div', 'testimonial-case-details');
    details.append(element('strong', '', item.business || item.client), element('span', '', item.service || 'Serviço 360'));
    const button = element('button', 'testimonial-open', item.ready ? 'Assistir ao depoimento' : 'Ler relato');
    button.type = 'button';
    button.setAttribute('aria-haspopup', 'dialog');
    button.setAttribute('aria-label', item.ready ? `Abrir vídeo de ${item.client}` : `Ler relato de ${item.client}`);
    button.append(icon(item.ready ? 'play' : 'arrow-up'));
    button.addEventListener('click', () => openItem(item, button));
    body.append(details, button);
    card.append(body);
    track.append(card);
    const dot = element('button', 'testimonial-dot');
    dot.type = 'button';
    dot.setAttribute('aria-label', `Mostrar depoimento ${index + 1}: ${item.tag.toLowerCase()}`);
    dot.setAttribute('aria-controls', 'testimonials-track');
    dot.addEventListener('click', () => scrollToCard(index));
    dots.append(dot);
  });

  const cards = [...track.children];
  const dotButtons = [...dots.children];
  const update = () => {
    const bounds = track.getBoundingClientRect();
    const visible = cards.map((card, index) => ({ index, rect: card.getBoundingClientRect() }))
      .filter(({ rect }) => rect.left >= bounds.left - 6 && rect.right <= bounds.right + 6);
    const stride = cards.length > 1 ? cards[1].offsetLeft - cards[0].offsetLeft : cards[0].offsetWidth;
    const first = visible.length ? visible[0].index : Math.min(cards.length - 1, Math.max(0, Math.round(track.scrollLeft / stride)));
    const last = visible.length ? visible[visible.length - 1].index : first;
    const text = `${first === last ? first + 1 : `${first + 1}–${last + 1}`} de ${items.length}`;
    if (status.textContent !== text) status.textContent = text;
    previous.disabled = track.scrollLeft <= 4;
    next.disabled = track.scrollLeft >= track.scrollWidth - track.clientWidth - 4;
    dotButtons.forEach((button, index) => {
      button.classList.toggle('is-visible', index >= first && index <= last);
      button.setAttribute('aria-label', `Mostrar depoimento ${index + 1}: ${items[index].tag.toLowerCase()}${index >= first && index <= last ? ' (visível)' : ''}`);
    });
  };
  const scrollToCard = index => {
    track.scrollTo({ left: cards[index].offsetLeft - cards[0].offsetLeft, behavior: reducedMotion.matches ? 'auto' : 'smooth' });
  };
  const step = direction => {
    const stride = cards.length > 1 ? cards[1].offsetLeft - cards[0].offsetLeft : cards[0].offsetWidth;
    track.scrollBy({ left: direction * stride, behavior: reducedMotion.matches ? 'auto' : 'smooth' });
  };
  previous.addEventListener('click', () => step(-1));
  next.addEventListener('click', () => step(1));
  track.addEventListener('scroll', () => { clearTimeout(scrollTimer); scrollTimer = setTimeout(update, 120); }, { passive: true });
  track.addEventListener('keydown', event => {
    if (event.target !== track || !['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
    event.preventDefault();
    if (event.key === 'Home') scrollToCard(0);
    else if (event.key === 'End') scrollToCard(items.length - 1);
    else step(event.key === 'ArrowLeft' ? -1 : 1);
  });
  new ResizeObserver(update).observe(track);

  function openItem(item, button) {
    opener = button;
    dialog.querySelector('#testimonial-dialog-label').textContent = item.ready ? 'DEPOIMENTO' : 'RELATO';
    dialog.querySelector('#testimonial-dialog-title').textContent = item.title;
    dialog.querySelector('#testimonial-dialog-intro').textContent = item.summary;
    const client = dialog.querySelector('#testimonial-client');
    client.hidden = false;
    client.textContent = [item.client, item.role, item.service].filter(Boolean).join(' · ');
    transcript.hidden = false;
    transcript.open = !item.ready;
    transcript.querySelector('summary').textContent = item.ready ? 'Ler transcrição' : 'Relato completo';
    transcript.querySelector('p').textContent = item.transcript;
    player.replaceChildren();
    player.hidden = false;
    videoError.hidden = true;
    captionsError.hidden = true;
    if (!item.ready) {
      const portrait = element('div', 'testimonial-dialog-photo');
      portrait.style.backgroundPosition = `${item.portraitIndex * 25}% center`;
      portrait.setAttribute('role', 'img');
      portrait.setAttribute('aria-label', item.client);
      player.append(portrait);
      document.body.classList.add('testimonial-opened');
      dialog.showModal();
      dialog.scrollTop = 0;
      return;
    }
    const video = document.createElement('video');
    video.controls = true;
    video.playsInline = true;
    video.preload = 'none';
    video.src = item.videoSrc;
    video.poster = item.poster;
    video.setAttribute('aria-label', `Depoimento de ${item.client}`);
    const captions = document.createElement('track');
    captions.kind = 'captions';
    captions.src = item.captionsSrc;
    captions.srclang = 'pt-BR';
    captions.label = 'Português';
    captions.default = true;
    captions.addEventListener('error', () => { captionsError.hidden = false; transcript.open = true; });
    video.append(captions);
    video.addEventListener('error', () => { videoError.hidden = false; });
    player.append(video);
    document.body.classList.add('testimonial-opened');
    dialog.showModal();
    dialog.scrollTop = 0;
    video.play().catch(() => {});
  }
  dialog.querySelector('.testimonial-dialog-close').addEventListener('click', () => dialog.close());
  dialog.addEventListener('click', event => {
    if (event.target !== dialog) return;
    const box = dialog.getBoundingClientRect();
    if (event.clientX < box.left || event.clientX > box.right || event.clientY < box.top || event.clientY > box.bottom) dialog.close();
  });
  dialog.addEventListener('close', () => {
    const video = player.querySelector('video');
    if (video) { video.pause(); video.removeAttribute('src'); video.load(); }
    player.replaceChildren();
    document.body.classList.remove('testimonial-opened');
    if (opener) opener.focus({ preventScroll: true });
  });
  update();
})();
